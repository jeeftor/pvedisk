[Unit]
Description=pvedisk HTTP MCP server
After=network.target pve-cluster.service

[Service]
Type=simple
User=root
Group=root
UMask=0077
# Save this file's listener/authentication choices with mcp setup before enabling.
ExecStart=/usr/local/bin/pvedisk --config /etc/pvedisk/config.yaml mcp --mcp-config /etc/pvedisk/mcp.yaml
Restart=on-failure
RestartSec=5
# Detached repair workers must survive an MCP server restart.
# Keep host mount visibility: do not add private mount namespaces.
KillMode=process
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
