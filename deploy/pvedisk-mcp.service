[Unit]
Description=pvedisk HTTP MCP server
After=network.target pve-cluster.service

[Service]
Type=simple
User=root
Group=root
UMask=0077
# This template intentionally allows tokenless clients on your airgap LAN.
# Replace --no-token with --token-file /etc/pvedisk/mcp.token for bearer auth.
ExecStart=/usr/local/bin/pvedisk --config /etc/pvedisk/config.yaml mcp --listen 0.0.0.0:8766 --no-token
Restart=on-failure
RestartSec=5
# Detached repair workers must survive an MCP server restart.
# Keep host mount visibility: do not add private mount namespaces.
KillMode=process
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
